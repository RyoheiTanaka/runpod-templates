{
  "$schema": "https://opencode.ai/config.json",
  "model": "runpod/qwen3",
  "providers": {
    "runpod": {
      "name": "RunPod vLLM",
      "env": ["VLLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "qwen3": {
          "name": "Qwen3 8B",
          "modelID": "Qwen/Qwen3-8B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false
  }
}
